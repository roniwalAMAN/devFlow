# ==============================================================================
# DevFlow Environment Configuration Reference
# ==============================================================================
# IMPORTANT: Never commit actual secret keys, passwords, or production tokens.
# Use this reference template to configure environment variables across:
# 1. Vercel (Frontend Web Service)
# 2. Render (Backend Express + Socket.IO Web Service)
# 3. Render (Optional Dedicated Background Worker Service)
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. FRONTEND ENVIRONMENT VARIABLES (Set in Vercel Project Settings)
# ------------------------------------------------------------------------------
# Public URL of the deployed Render backend Express API (no trailing slash)
# Read at Next.js build time and runtime in client components
NEXT_PUBLIC_API_URL=https://devflow-api.onrender.com

# Public URL of the persistent Socket.IO WebSocket server (no trailing slash)
# Read by the browser client when opening real-time connections
NEXT_PUBLIC_SOCKET_URL=https://devflow-api.onrender.com

# ------------------------------------------------------------------------------
# 2. BACKEND SERVER ENVIRONMENT VARIABLES (Set in Render Web Service)
# ------------------------------------------------------------------------------
# Port is automatically assigned and injected by Render at runtime (defaults to 10000 on Render)
PORT=10000
NODE_ENV=production

# Client origins allowed to make CORS requests and connect via Socket.IO
# Provide your production Vercel domain and any preview/custom domains (comma-separated)
CLIENT_URL=https://devflow.vercel.app,https://your-custom-domain.com

# Managed PostgreSQL Connection String (from Neon, Supabase, AWS RDS, or Render PostgreSQL)
# For transaction poolers (e.g. Supabase pgBouncer), ensure ?pgbouncer=true or direct port 5432 is used
DATABASE_URL=postgresql://user:password@host.managed-postgres.com:5432/devflow?sslmode=require

# Managed Redis Connection String (from Upstash, Redis Cloud, Aiven, or Render Redis)
# For TLS connections, use the rediss:// protocol prefix
REDIS_URL=rediss://default:password@host.managed-redis.com:6379

# Authentication Secrets (Generate with: openssl rand -base64 32)
JWT_SECRET=replace-with-a-secure-random-32-byte-base64-secret-key
JWT_REFRESH_SECRET=replace-with-a-secure-random-32-byte-refresh-secret-key
JWT_EXPIRES_IN=15m
REFRESH_TOKEN_EXPIRES_IN=7d

# AES-256-GCM Encryption Secret (MUST be exactly 64 hexadecimal characters / 32 bytes)
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
ENCRYPTION_SECRET=replace_with_exactly_64_hex_characters_0123456789abcdef0123456789abcdef

# GitHub OAuth Integration
# Register an OAuth App on GitHub under Developer Settings:
# - Homepage URL: https://devflow.vercel.app
# - Authorization Callback URL: https://devflow-api.onrender.com/api/github/callback
GITHUB_CLIENT_ID=your-github-oauth-client-id
GITHUB_CLIENT_SECRET=your-github-oauth-client-secret
GITHUB_CALLBACK_URL=https://devflow-api.onrender.com/api/github/callback

# Google Gemini AI API Key (from Google AI Studio: https://aistudio.google.com/)
GEMINI_API_KEY=your-gemini-api-key

# Worker Execution Control:
# Set to 'true' (or omit) to run BullMQ workers inside the unified Express web service.
# Set to 'false' if deploying a separate Render Background Worker service.
RUN_WORKERS=true

# ------------------------------------------------------------------------------
# 3. BACKGROUND WORKER ENVIRONMENT VARIABLES (Set in Render Background Worker)
# ------------------------------------------------------------------------------
# If running background jobs in a dedicated worker service:
# - DATABASE_URL=postgresql://user:password@host.managed-postgres.com:5432/devflow?sslmode=require
# - REDIS_URL=rediss://default:password@host.managed-redis.com:6379
# - ENCRYPTION_SECRET=replace_with_the_same_64_hex_char_secret_as_backend
# - GEMINI_API_KEY=your-gemini-api-key
# - NODE_ENV=production
