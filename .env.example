# ==============================================================================
# DevFlow Environment Configuration Template
# ==============================================================================

# Client (Frontend)
CLIENT_URL=http://localhost:3000
NEXT_PUBLIC_API_URL=http://localhost:3001
NEXT_PUBLIC_SOCKET_URL=http://localhost:3001

# Server (Backend)
PORT=3001
NODE_ENV=development

# Database (PostgreSQL 16)
DATABASE_URL=postgresql://devflow:devflow_secret@localhost:5432/devflow?schema=public

# Authentication & Security
JWT_SECRET=devflow-super-secret-jwt-key-for-local-dev-min-32-chars
JWT_REFRESH_SECRET=devflow-super-secret-jwt-refresh-key-local-32-chars
JWT_EXPIRES_IN=15m
REFRESH_TOKEN_EXPIRES_IN=7d
ENCRYPTION_SECRET=0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef

# Redis Cache & BullMQ Background Processing
REDIS_URL=redis://localhost:6379

# GitHub OAuth Integration
GITHUB_CLIENT_ID=your-github-client-id
GITHUB_CLIENT_SECRET=your-github-client-secret
GITHUB_CALLBACK_URL=http://localhost:3001/api/github/callback

# Google Gemini AI Coding Assistant
GEMINI_API_KEY=your-gemini-api-key
